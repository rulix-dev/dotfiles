
get_es_toolbox_pod() {
  local namespace=$1
  kubectl get pod -n "$namespace" -l app="elasticsearch-toolbox" -o=jsonpath="{.items[0].metadata.name}"
}

alias es-dora-staging='ddtool clusters context stripe.us1.staging.dog && \
kubectl exec -n elasticsearch-dora -it $(get_es_toolbox_pod "elasticsearch-dora") -- bash'

