
__rulix_dev_stow_dotfiles() {
  local STOW_ROOT="$1"
  [[ -n "$STOW_ROOT" ]] || { echo "ERROR: STOW_ROOT is empty" >&2; return 1; }
  [[ -d "$STOW_ROOT" ]] || { echo "ERROR: '$STOW_ROOT' is not a valid directory" >&2; return 1; }
  [[ -f "$STOW_ROOT/.zshrc" && ! -L "$STOW_ROOT/.zshrc" ]] || { echo "ERROR: '$STOW_ROOT/.zshrc' not found or is a symlink" >&2; return 1; }

  local STOW_PARENT="$(dirname "$STOW_ROOT")"
  local PACKAGE="$(basename "$STOW_ROOT")"

  local DRY_RUN=false
  if [[ "${2:-}" == "--dry-run" ]]; then
    DRY_RUN=true
  fi

  local STOW_FLAGS=()
  if $DRY_RUN; then
    STOW_FLAGS+=(-n -v)
  fi

  # Pre-create directory structure in HOME so stow links files, not directories
  find "$STOW_ROOT" -mindepth 1 -type d | while read -r dir; do
    relative="${dir#"$STOW_ROOT"/}"
    mkdir -p "$HOME/$relative"
  done

  # Remove existing files/symlinks in HOME that would conflict with stow
  # (the package itself may contain symlinks, e.g. .pi/agent/AGENTS.md)
  find "$STOW_ROOT" \( -type f -o -type l \) | while read -r file; do
    relative="${file#"$STOW_ROOT"/}"
    target="$HOME/$relative"
    if [[ -e "$target" || -L "$target" ]]; then
      if $DRY_RUN; then
        echo "REMOVE: $relative"
      else
        rm "$target"
      fi
    fi
  done

  stow -d "$STOW_PARENT" -t "$HOME" --override='.*' "${STOW_FLAGS[@]}" "$PACKAGE"
}


__rulix_dev_zsh_setup() {
    if [[ -f "${HOME}/.zshrc.setup" ]]; then
        return 0
    fi

    # Rust Installation
    curl https://sh.rustup.rs -sSf | sh -s -- -y

    # zoxide
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh

    # starship
    sudo curl -sS https://starship.rs/install.sh | sh -s -- -y

    # gh dash
    gh extension install dlvhdr/gh-dash

    # sesh tmux plugin
    go install github.com/joshmedeski/sesh/v2@latest

    # gum 
    go install github.com/charmbracelet/gum@latest

    # fzf
    git -C "$HOME/.fzf" pull 2>/dev/null || \
      git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
    ~/.fzf/install --bin

    # My dotfiles
    git -C "$HOME/rulix-dev/dotfiles" pull 2>/dev/null || \
      git clone https://github.com/rulix-dev/dotfiles "$HOME/rulix-dev/dotfiles"
    $HOME/rulix-dev/dotfiles/install.sh

    # stow dotfiles
    __rulix_dev_stow_dotfiles "$HOME/rulix-dev/dotfiles/target/home"

    # tmux plugins
    git -C "$HOME/.tmux/plugins/tpm" pull 2>/dev/null || \
      git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
    ~/.tmux/plugins/tpm/bin/install_plugins
    # tmux reload
    tmux source-file ~/.tmux.conf


    # Merge Claude Settings
    __rulix_dev_merge_claude_settings

    # Pi coding agent, configured like Claude
    __rulix_dev_pi_setup

    # Create file to avoid setup next time
    touch "${HOME}/.zshrc.setup"
}

# Deep-merge the JSON overlay $2 into $1 (overlay wins). Top-level arrays are
# unioned instead of replaced, keeping order, so list-like settings (e.g. pi
# "packages"/"skills") keep the entries other tools added.
__rulix_dev_merge_json() {
  local base="$1"
  local overlay="$2"

  [[ -f "$overlay" ]] || return 0

  if [[ ! -f "$base" ]]; then
    cp "$overlay" "$base"
    return 0
  fi

  local merged
  merged="$(jq -s '
    def union($a; $b): reduce ($a + $b)[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);
    .[0] as $base | .[1] as $overlay
    | reduce ($overlay | to_entries[] | select(.value | type == "array")) as $e
        ($base * $overlay; .[$e.key] = union($base[$e.key] // []; $e.value))
  ' "$base" "$overlay")" || return 1
  # printf, not echo: zsh's echo would expand backslash escapes inside the JSON
  printf '%s\n' "$merged" > "$base"
}

__rulix_dev_merge_claude_settings() {
  local base="$HOME/.claude/settings.json"
  local overlay="$HOME/.claude/settings.rpc.json"

  if [[ ! -f "$base" && ! -f "$overlay" ]]; then
    return 0
  fi

  __rulix_dev_merge_json "$base" "$overlay" || return 1

  __rulix_dev_claude_mcp_sync
}

# Claude Code reads user-scope MCP servers from ~/.claude.json (not from
# settings.json). Only the servers below are managed here: each one is removed
# and re-added (re-running means re-authenticating them); others are left alone.
__rulix_dev_claude_mcp_sync() {
  command -v claude &>/dev/null || return 0

  # All GA toolsets plus the read-only previews (apm, investigator,
  # live-debugger); remote-actions left out on purpose.
  # https://docs.datadoghq.com/bits_ai/mcp_server/setup/
  local dd_toolsets="core,alerting,apm,assistant,audit-trail,cases,code-exec,cost,dashboards,data-observability,dbm,ddsql,derived-metrics,documentation,error-tracking,feature-flags,governance,investigator,kubernetes,live-debugger,llmobs,logs-configuration,networks,notebooks,observability-pipelines,onboarding,product-analytics,profiling,reference-tables,rum,security,sheets,software-delivery,synthetics,widgets,workflows"

  # name / JSON pairs, in the order they should appear. Slack and the browser
  # (Playwright) come from plugins enabled in settings.rpc.json instead.
  local -a servers=(
    atlassian        '{"type":"http","url":"https://mcp.atlassian.com/v1/mcp/authv2"}'
    datadog-us       '{"type":"http","url":"https://mcp.datadoghq.com/v1/mcp?toolsets='$dd_toolsets'"}'
    datadog-eu       '{"type":"http","url":"https://mcp.datadoghq.eu/v1/mcp?toolsets='$dd_toolsets'"}'
    google-workspace '{"type":"http","url":"https://google-workspace-mcp-server-834963730936.us-central1.run.app/mcp"}'
  )

  local name json
  for name json in "${servers[@]}"; do
    claude mcp remove --scope user "$name" &>/dev/null
    claude mcp add-json --scope user "$name" "$json" >/dev/null || echo "WARN: could not add MCP server $name" >&2
  done
}

# Pi (https://datadoghq.atlassian.net/wiki/spaces/AIDEVX/pages/6970966751/Pi):
# install the Datadog golden config with pi-setup, then layer our settings on
# top so pi mirrors Claude:
#   - ~/.pi/agent/settings.rpc.json: ~/.claude/skills as a skills source, and the
#     claude-marketplace package, which bridges the Claude plugins enabled in
#     ~/.claude/settings.json (skills, commands, agents) into pi
#   - ~/.pi/agent/AGENTS.md (stowed): symlink to ~/.claude/CLAUDE.md
#   - ~/.config/mcp/mcp.json (stowed): same MCP servers as Claude (datadog-us/eu
#     with the same toolsets as __rulix_dev_claude_mcp_sync - keep both lists in
#     sync - google-workspace, chrome-devtools), the golden "datadog" disabled,
#     and approveTools (ask before write tools). pi-setup rewrites the golden
#     entries in ~/.pi/agent/mcp.json on every run; this lower-precedence file
#     is merged field by field by pi-mcp-adapter, and pi-setup never touches
#     it. Edit it here, not with pi's "/mcp setup" (its global target is this
#     file, overwritten on install).
__rulix_dev_pi_setup() {
  if ! command -v pi-setup &>/dev/null; then
    if ! command -v dogbrew &>/dev/null; then
      echo "WARN: dogbrew not found, skipping pi setup" >&2
      return 0
    fi
    dogbrew install pi-setup || return 1
    rehash
  fi

  # --skip-auth keeps the bootstrap non-interactive (datadog.team comes from
  # ~/.gitconfig); run `pi-setup` again later if `pi-setup doctor` reports a
  # missing ddtool login. Heads-up: pi-setup hard-resets
  # ~/dd/datadog-pi-packages on every run.
  pi-setup --skip-auth || echo "WARN: pi-setup failed, re-run it manually" >&2

  __rulix_dev_merge_json "$HOME/.pi/agent/settings.json" "$HOME/.pi/agent/settings.rpc.json"

  echo "pi: check with 'pi-setup doctor', then authenticate MCP servers inside pi with /mcp"
}

__rulix_dev_zsh_setup

[[ -s "$HOME/.zshrc.zshinit" ]] && source "$HOME/.zshrc.zshinit"

[[ -s "$HOME/.zshrc.Claude" ]] && source "$HOME/.zshrc.Claude"

for f in "$HOME"/.zshrc.dd*; do
    [[ -s "$f" ]] && source "$f"
done

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Shell integrations
eval "$(fzf --zsh)"

# starship
eval "$(starship init zsh)"

# zoxide must be initialized last
eval "$(zoxide init --cmd cd zsh)"

[[ -s "$HOME/.zshrc.User" ]] && source "$HOME/.zshrc.User"
