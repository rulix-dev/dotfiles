
# --- Stable SSH agent socket -------------------------------------------------
# Long-lived processes (tmux server, Claude, editors) capture $SSH_AUTH_SOCK at
# launch. When the real agent socket changes across SSH logins, that captured
# path goes stale and git signing/auth breaks ("could not connect to agent").
# Keep a fixed symlink that each fresh login refreshes, and always point this
# shell at it so the path never goes stale.
if [[ -S "$SSH_AUTH_SOCK" && "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ]]; then
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi
[[ -S "$HOME/.ssh/agent.sock" ]] && export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
# -----------------------------------------------------------------------------

## Unsetting context to make sure every time the context is needed (avoid accidental commands)
(( $+commands[kubectl] )) && kubectl config unset current-context

alias ls='ls --color'

fuzzygrep() {
  grep -rnI "$1" . | \
    fzf --delimiter : \
        --preview 'bat --style=numbers --color=always --highlight-line {2} {1}' \
        --preview-window=70% --bind shift-up:preview-page-up,shift-down:preview-page-down
}

fzfgrep() {
	fzf --preview "grep --color=always -C 10 $1 {}"
}

todate() {
  local seconds="$1"
  local nanos="${2:-0}"

  if [[ -z "$seconds" ]]; then
    echo "Uso: ts2date <seconds> [nanos]" >&2
    return 1
  fi

  # Convertir nanosegundos a fracción de segundo
  local frac=""
  if [[ "$nanos" -ne 0 ]]; then
    frac=".$(printf '%09d' "$nanos")"
  fi

  # GNU date (Linux) vs BSD date (macOS)
  if date -d @0 >/dev/null 2>&1; then
    # Linux
    date -u -d "@${seconds}" +"%Y-%m-%dT%H:%M:%S${frac}Z"
  else
    # macOS
    date -u -r "${seconds}" +"%Y-%m-%dT%H:%M:%S${frac}Z"
  fi
}

tots() {
  if [[ -z "$1" ]]; then
    echo "Uso: date2ts <fecha>" >&2
    return 1
  fi

  local input="$*"

  # GNU date (Linux) vs BSD date (macOS)
  if date -d "1970-01-01" >/dev/null 2>&1; then
    # Linux
    date -u -d "$input" +%s
  else
    # macOS
    date -u -j -f "%Y-%m-%dT%H:%M:%S%z" "$input" +%s 2>/dev/null \
    || date -u -j -f "%Y-%m-%dT%H:%M:%S" "$input" +%s
  fi
}

## Session picker (tmux + herdr) -------------------------------------------
# `mux pick` picks the backend from where it runs: tmux inside tmux, herdr
# inside herdr, and $MUX_PREFERRED (default herdr) anywhere else. New-session
# names come from ~/.config/mux-picker/got-names.txt.
export MUX_PREFERRED=${MUX_PREFERRED:-herdr}

function sesh-sessions() {
  {
    exec </dev/tty
    exec <&1
    mux pick
    zle reset-prompt > /dev/null 2>&1 || true
  }
}

zle     -N             sesh-sessions
bindkey -M emacs '\es' sesh-sessions
bindkey -M vicmd '\es' sesh-sessions
bindkey -M viins '\es' sesh-sessions

## Auto-launch the picker on a new terminal, but never inside a multiplexer:
## herdr panes do not set $TMUX, so without the HERDR_ENV guard every new herdr
## pane would jump into tmux and hide its agents from herdr.
if [[ -z "$TMUX" && ${HERDR_ENV:-} != 1 ]] && command -v mux &>/dev/null && [[ $- == *i* ]] && [[ -t 0 ]]; then
  mux pick
fi

export PATH=$HOME/rulix-dev/dotfiles/target/home/.local/bin:$PATH
