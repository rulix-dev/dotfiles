#!/usr/bin/env python3
"""rcode - open workspace paths in the Mac's VS Code (or Cursor) over Remote-SSH.

  rcode [-r|--reuse] [-F|--folder] [PATH[:LINE[:COL]] ...]   default: .

Sends each path through the SSH tunnel to `rcode-listener` on the Mac
(RemoteForward 127.0.0.1:47011, see `rcode-listener ssh-config`), which opens
vscode://vscode-remote/ssh-remote+<host><path>. Without the tunnel it prints a
clickable link instead (Cmd+click in the terminal).

  - a directory with exactly one *.code-workspace opens that workspace
    (all its folders, e.g. the task folder and its worktrees); -F opens the
    plain folder instead
  - folders and workspaces open in a new window; -r reuses the current one
  - files open in the current window, at LINE:COL when given

  RCODE_EDITOR    vscode (default) | cursor
  RCODE_SSH_HOST  SSH alias of this workspace on the Mac
                  (default: workspace-$WORKSPACE_NAME)
  RCODE_PORT      tunnel port in the workspace (default 47011)
"""
import json
import os
import re
import socket
import sys
from urllib.parse import quote

SCHEMES = {"vscode": "vscode", "code": "vscode", "cursor": "cursor"}


def target(arg):
    """Split an optional :line[:col] suffix, but only when the plain path does not exist."""
    m = re.match(r"^(.*?):(\d+)(?::(\d+))?$", arg)
    if m and not os.path.exists(arg) and os.path.exists(m.group(1)):
        return os.path.abspath(m.group(1)), int(m.group(2)), int(m.group(3)) if m.group(3) else None
    return os.path.abspath(arg), None, None


def workspace_file(directory):
    """The single *.code-workspace in a directory, if there is exactly one."""
    try:
        found = [f for f in os.listdir(directory) if f.endswith(".code-workspace")]
    except OSError:
        return None
    return os.path.join(directory, found[0]) if len(found) == 1 else None


def url_for(request):
    path, line, col = request["path"], request.get("line"), request.get("col")
    if request["kind"] == "file" and not line and not path.endswith(".code-workspace"):
        line = 1
    suffix = (f":{line}" if line else "") + (f":{col}" if line and col else "")
    query = "?windowId=_blank" if request.get("new_window") else ""
    return f"{request['editor']}://vscode-remote/ssh-remote+{request['host']}{quote(path)}{suffix}{query}"


def send(port, request):
    """Returns the listener's reply, or None when there is no tunnel."""
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=1.5) as s:
            s.settimeout(20)
            s.sendall((json.dumps(request) + "\n").encode())
            data = b""
            while b"\n" not in data:
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
        return json.loads(data.decode().split("\n", 1)[0])
    except (OSError, ValueError):
        return None


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    reuse = folder_only = False
    while args and args[0].startswith("-") and args[0] != "-":
        flag = args.pop(0)
        if flag in ("-r", "--reuse"):
            reuse = True
        elif flag in ("-F", "--folder"):
            folder_only = True
        elif flag == "--":
            break
        else:
            sys.exit(f"rcode: unknown option {flag} (see rcode --help)")
    args = args or ["."]
    editor = os.environ.get("RCODE_EDITOR", "vscode")
    if editor not in SCHEMES:
        sys.exit(f"rcode: unknown RCODE_EDITOR {editor!r} (vscode or cursor)")
    editor = SCHEMES[editor]
    host = os.environ.get("RCODE_SSH_HOST") or (
        f"workspace-{os.environ['WORKSPACE_NAME']}" if os.environ.get("WORKSPACE_NAME") else "")
    if not host:
        sys.exit("rcode: set RCODE_SSH_HOST (no $WORKSPACE_NAME here)")
    port = int(os.environ.get("RCODE_PORT", "47011"))

    status, warned = 0, False
    for arg in args:
        path, line, col = target(arg)
        if not os.path.exists(path):
            print(f"rcode: {arg}: no such file or directory", file=sys.stderr)
            status = 1
            continue
        kind = "folder" if os.path.isdir(path) else "file"
        if kind == "folder" and not folder_only:
            ws = workspace_file(path)
            if ws:
                path, kind = ws, "file"
                print(f"rcode: opening workspace {os.path.basename(ws)} (-F for the plain folder)", file=sys.stderr)
        opens_window = kind == "folder" or path.endswith(".code-workspace")
        request = {"v": 1, "host": host, "path": path, "kind": kind, "editor": editor,
                   "new_window": opens_window and not reuse}
        if line:
            request["line"] = line
            if col:
                request["col"] = col
        reply = send(port, request)
        if reply and reply.get("ok"):
            continue
        if reply:  # the listener answered but refused or failed
            print(f"rcode: {arg}: {reply.get('error', 'failed')}", file=sys.stderr)
            status = 1
            continue
        # No tunnel: fall back to a clickable link (OSC 8) plus the plain URL.
        url = url_for(request)
        if not warned:
            print(f"rcode: no tunnel on 127.0.0.1:{port}. Is rcode-listener running on the Mac? If it worked "
                  "before, the SSH connection holding the tunnel closed: on the Mac run\n"
                  f"  pkill -f 'ssh.*{host}'\n"
                  "(herdr reconnects on its own). Meanwhile, Cmd+click to open:", file=sys.stderr)
            warned = True
        label = arg if sys.stdout.isatty() else url
        print(f"\033]8;;{url}\033\\{label}\033]8;;\033\\" if sys.stdout.isatty() else url)
        if sys.stdout.isatty():
            print(f"  {url}")
        status = 1
    return status


if __name__ == "__main__":
    sys.exit(main())
